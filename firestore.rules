rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return userProfileExists()
        && currentUser().data.active == true;
    }

    function roleIs(role) {
      return activeUser()
        && currentUser().data.role == role;
    }

    function oneOfRoles(roles) {
      return activeUser()
        && currentUser().data.role in roles;
    }

    function admin() {
      return roleIs('Admin');
    }

    function management() {
      return oneOfRoles(['Admin', 'Management']);
    }

    function salesOrManagement() {
      return oneOfRoles(['Admin', 'Management', 'Sales']);
    }

    function rdOrManagement() {
      return oneOfRoles(['Admin', 'Management', 'R&D']);
    }

    function orderOperationalFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'readiness',
        'productionStatus',
        'qcStatus',
        'dispatchStatus',
        'tracking',
        'operationsNotes',
        'committedDate',
        'updatedAt'
      ]);
    }

    function orderFinanceFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'total',
        'advance',
        'balance',
        'paymentDue',
        'paymentStatus',
        'updatedAt'
      ]);
    }

    match /users/{userId} {
      // Every signed-in user may read their own profile first.
      allow get: if signedIn() && request.auth.uid == userId;

      // Admin / Management may browse staff profiles.
      allow get, list: if management();

      // Only the Master/Admin may create, edit or deactivate staff profiles.
      allow create, update, delete: if admin();
    }

    match /customers/{customerId} {
      allow read: if activeUser();
      allow create, update: if salesOrManagement();
      allow delete: if admin();
    }

    match /leads/{leadId} {
      allow read: if oneOfRoles([
        'Admin',
        'Management',
        'Sales',
        'R&D'
      ]);

      allow create, update: if salesOrManagement();

      allow delete: if oneOfRoles([
        'Admin',
        'Management',
        'Sales'
      ]);
    }

    match /projects/{projectId} {
      allow read: if activeUser();

      allow create: if salesOrManagement();

      allow update: if oneOfRoles([
        'Admin',
        'Management',
        'Sales',
        'R&D'
      ]);

      allow delete: if admin();
    }

    // Confidential formula records are separated from general Project data.
    match /formulas/{formulaId} {
      allow read, create, update: if rdOrManagement();
      allow delete: if admin();
    }

    match /samples/{sampleId} {
      allow read: if activeUser();

      allow create, update: if oneOfRoles([
        'Admin',
        'Management',
        'R&D',
        'Sales'
      ]);

      allow delete: if oneOfRoles([
        'Admin',
        'Management',
        'R&D'
      ]);
    }

    match /quotations/{quotationId} {
      allow read: if oneOfRoles([
        'Admin',
        'Management',
        'Sales',
        'Finance',
        'Operations'
      ]);

      allow create, update: if oneOfRoles([
        'Admin',
        'Management',
        'Sales',
        'Finance'
      ]);

      allow delete: if management();
    }

    match /orders/{orderId} {
      allow read: if activeUser();

      allow create: if oneOfRoles([
        'Admin',
        'Management',
        'Sales'
      ]);

      // Admin / Management can update the whole order.
      // Operations can update operational fields only.
      // Finance can update payment fields only.
      allow update: if management()
        || (
          roleIs('Operations')
          && orderOperationalFieldsOnly()
        )
        || (
          roleIs('Finance')
          && orderFinanceFieldsOnly()
        );

      allow delete: if admin();
    }

    match /calendarEvents/{eventId} {
      allow read: if activeUser();
      allow create, update: if activeUser();
      allow delete: if management()
        || (
          activeUser()
          && resource.data.createdByUid == request.auth.uid
        );
    }

    match /activities/{activityId} {
      allow read: if activeUser();
      allow create: if activeUser();

      // Activity history is append-only.
      allow update, delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if management();
      allow create: if activeUser();

      // Audit history is append-only.
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if management();
      allow write: if admin();
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
